<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>0.9.1</Version>
    <ServerRoot Condition="'$(ServerRoot)' == ''">$(MSBuildThisFileDirectory)..\..</ServerRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ModUI_Export.cs" />
    <Compile Include="ModUIData.cs" />
    <Compile Include="Si_Logistics.cs" />
    <Compile Include="LogisticsPerformance.cs" />
    <Compile Include="LogisticsRewards.cs" />
    <Compile Include="LogisticsScore.cs" />
    <Compile Include="CommanderScore.cs" />
    <Compile Include="HarvesterFix.cs" />
    <Compile Include="AITransport.cs" />
    <Compile Include="AITransportAllocation.cs" />
    <Reference Include="0Harmony"><HintPath>$(ServerRoot)\MelonLoader\net35\0Harmony.dll</HintPath><Private>False</Private></Reference>
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.0" />
    <Reference Include="SilicaCore"><HintPath>SilicaCore.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Si_AdminMod"><HintPath>Si_AdminMod.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>UnityEngine.CoreModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.TerrainModule"><HintPath>$(ServerRoot)\Silica_Data\Managed\UnityEngine.TerrainModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ServerRoot)\Silica_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>Newtonsoft.Json.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
</Project>
